PROJECT_NAME="RB-Net Missense Variant Pathogenicity Classification System"
API_V1_STR="/api/v1"
DATABASE_URL="postgresql://rbnet_user:rbnet_secret_password@127.0.0.1:5433/rbnet_genomics"
MODEL_WEIGHTS_PATH="ml_artifacts/rb_net_best.pth"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# === RB-Net Local Server & VEP Docker Paths (Drive F:) ===
VEP_CONTAINER_NAME=rbnet_vep
VEP_TMP_DIR=F:/BioData/vep_data/tmp_io
VEP_CACHE_VERSION=116
HG38_FASTA_PATH=F:/VEP_RESOURCES/Homo_sapiens.GRCh38.dna.primary_assembly.fa
HG38_PEP_FASTA_PATH=F:/VEP_RESOURCES/Homo_sapiens.GRCh38.pep.all.fa
SPLICEAI_VCF_PATH=F:/VEP_RESOURCES/spliceai_scores.raw.snv.ensembl_mane_v1.4.grch38.vcf.gz
DBNSFP_CONTAINER_PATH=/vep_resources/dbNSFP5.3.1a_grch38.gz
VEP_TMP_CONTAINER_DIR=/tmp_io
# === Pure DL Inference ===
# auto = dùng CUDA nếu torch build có CUDA, ngược lại CPU
INFERENCE_DEVICE=auto
# Nơi tải trọng số NT-v1 500M + ESM2 650M (~5 GB); ổ C: gần đầy nên đặt trên F:
HF_HOME=F:/BioData/hf_cache
MODEL_ARTIFACTS_DIR=artifacts
# 6 file bio_*.pkl của normalizer.transform_bio (bio_mean_imputer, bio_freq_scaler, bio_phast_scaler,
# bio_phylo_scaler, bio_spliceai_fill_values, bio_spliceai_scaler)
BIO_SCALER_DIR=artifacts
# {config_id}.index của context train3 (vd nt_v1_500m_dna_1001_center.index) để tính LID
FAISS_INDEX_DIR=artifacts/faiss_indexes
# Số láng giềng tính LID; artifact train3 được fit với k=64 (đối chiếu median/IQR trong *_geom_v2_scalers.pkl)
GEOM_K_NEIGHBORS=64
# Khoá = 3 bit (use_dna, use_prot, use_biogeom). Chỉ cần copy file .pth vào đúng đường dẫn là tổ hợp được kích hoạt.
MODEL_CHECKPOINT_REGISTRY={"111":"artifacts/best_model_B_with_geometry.pth","110":"artifacts/best_model_110.pth","101":"artifacts/best_model_101.pth","011":"artifacts/best_model_011.pth","100":"artifacts/best_model_100.pth","010":"artifacts/best_model_010.pth","001":"artifacts/best_model_001.pth","dna,prot,bio":"artifacts/best_model_A_no_geometry.pth"}
MODEL_DECISION_THRESHOLDS={"111":0.637582,"dna,prot,bio":0.707937}
# ID "nucleotide-transformer-v1-500m-multi-species" không tồn tại trên HuggingFace. Đã đối chiếu thống kê
# embedding với scaler nt_v1_500m_dna_1001_center (chuẩn E_ref ~34.5, LVD_L2 trung vị ~12.5): khớp bản human-ref.
DNA_MODEL_ID=InstaDeepAI/nucleotide-transformer-500m-human-ref
PROT_MODEL_ID=facebook/esm2_t33_650M_UR50D
