PROJECT_NAME="TriMVPP - Missense Variant Pathogenicity Classification System"
API_V1_STR="/api/v1"
DATABASE_URL="postgresql://rbnet_user:rbnet_secret_password@127.0.0.1:5433/rbnet_genomics"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# === Local VEP Docker & reference data paths (Drive F:) ===
VEP_CONTAINER_NAME=rbnet_vep
VEP_TMP_DIR=F:/BioData/vep_data/tmp_io
VEP_TMP_CONTAINER_DIR=/tmp_io
VEP_CACHE_VERSION=116
HG38_FASTA_PATH=F:/VEP_RESOURCES/Homo_sapiens.GRCh38.dna.primary_assembly.fa
HG38_PEP_FASTA_PATH=F:/VEP_RESOURCES/Homo_sapiens.GRCh38.pep.all.fa
SPLICEAI_VCF_PATH=F:/VEP_RESOURCES/spliceai_scores.raw.snv.ensembl_mane_v1.4.grch38.vcf.gz
DBNSFP_CONTAINER_PATH=/vep_resources/dbNSFP5.3.1a_grch38.gz

# === Foundation models ===
# auto = dùng CUDA nếu torch build có CUDA, ngược lại CPU
INFERENCE_DEVICE=auto
# fp16 giống pipeline huấn luyện của nhóm (load_dtype=float16, không autocast)
FM_CUDA_DTYPE=fp16
# Nơi tải trọng số NT-v1 500M + ESM-1b 650M (~5 GB); đặt trên ổ còn trống
HF_HOME=F:/BioData/hf_cache
DNA_MODEL_ID=InstaDeepAI/nucleotide-transformer-500m-human-ref
PROT_MODEL_ID=facebook/esm1b_t33_650M_UR50S
DNA_CONFIG_ID=nt_v1_500m_dna_1001_center
PROT_CONFIG_ID=esm1b_650m_prot_501_center

# === TriMVPP artifacts (đường dẫn tương đối tính từ thư mục backend/) ===
# 6 file bio_*.pkl của normalizer.transform_bio (bio_mean_imputer, bio_freq_scaler, bio_phast_scaler,
# bio_phylo_scaler, bio_spliceai_fill_values, bio_spliceai_scaler)
BIO_SCALER_DIR=artifacts
# {config_id}_geom_v2_scalers.pkl (bộ geometry_v2_k64_step2_matched, fit trên train3)
MODEL_ARTIFACTS_DIR=artifacts/trimvpp/geom_scalers
# {config_id}.index (23 208 displacement của tập train) để tính LID
FAISS_INDEX_DIR=artifacts/trimvpp/faiss_indexes
# Số láng giềng tính LID; scaler được fit với k=64
GEOM_K_NEIGHBORS=64
# Baseline Integrated Gradients của notebook 19 (256 biến thể train3, seed 2026)
IG_BASELINE_PATH=artifacts/trimvpp/ig_baseline_train3_seed2026.pt

# 7 checkpoint đặt tại artifacts/trimvpp/checkpoints/trimvpp_{111,110,101,011,100,010,001}.pth.
# Đường dẫn, ngưỡng tau và MCC test mặc định nằm trong app/core/config.py; chỉ khai báo khi cần ghi đè, vd:
# MODEL_CHECKPOINT_REGISTRY={"111":"artifacts/trimvpp/checkpoints/trimvpp_111.pth"}
# MODEL_DECISION_THRESHOLDS={"111":0.4791317582130432}
