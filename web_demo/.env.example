# Copy this file to .env (next to docker-compose.yml) and choose a password.
# The same user, password, database and port must appear in DATABASE_URL of backend/.env:
#   postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>
POSTGRES_USER=rbnet_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rbnet_genomics
POSTGRES_PORT=5433
